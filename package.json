{
  "name": "pr-reviewer",
  "version": "0.0.0",
  "description": "Make AI-written PRs reviewable by humans: explain the change first, then review it.",
  "license": "MIT",
  "author": "Maurya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theaiowlandswan/pr-reviewer.git"
  },
  "type": "module",
  "bin": {
    "pr-reviewer": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars",
    "prompts"
  ],
  "engines": {
    "node": ">=14.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-grammars.mjs",
    "build:skill": "node scripts/build-skill.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "web-tree-sitter": "0.20.8"
  }
}
